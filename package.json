{
  "name": "family-medical-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地优先的家庭体检档案（PWA，数据仅存本机浏览器）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "sync:ocr": "node scripts/sync-ocr-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
